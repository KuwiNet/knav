# ---------------------------------------------------------------------------
# 数据库（knav 自有表结构，前缀 knav_）
# DB_PORT 默认 3307 是本地独立开发实例；线上按实际填写
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=
DB_NAME=knav_dev
DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# 首次部署自动创建站长
# 只在数据库里还没有站长（owner）时生效；已有站长后，这里改了也不会重置密码，
# 重置密码请用后台「个人中心」或 scripts/create-admin.ts。
# ADMIN_PASSWORD 留空则不自动创建；ADMIN_USERNAME 默认 admin；
# ADMIN_EMAIL 默认 <用户名>@knav.local，建议填真实邮箱（找回密码、通知都要用）。
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# 站点地址（生成邮件里的验证链接 / 找回密码链接 / LOGO）
# 优先使用后台「站点设置 → 站点地址」，未配置时才用这里
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SMTP 邮件
# 未配置时邮件不会真正发出，但会写入 knav_mail_log 并打印到服务端日志
# 后台「站点设置 → 邮件（SMTP）」里配置同名项同样生效，且优先级更低
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=knav
